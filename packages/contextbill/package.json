{
  "name": "contextbill",
  "version": "0.2.1",
  "description": "Local-first usage and cost report for coding-agent transcripts. Never sends your data anywhere.",
  "scripts": {
    "test": "vitest run",
    "build": "tsc",
    "lint": "eslint .",
    "test:watch": "vitest",
    "prepack": "npm run build",
    "prepublishOnly": "npm run lint && npm run test",
    "pretest": "npm run build"
  },
  "keywords": [
    "claude-code",
    "tokens",
    "cost",
    "observability",
    "cli"
  ],
  "author": "Mohammed Alkindi",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.3.0",
    "eslint": "^10.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "bin": {
    "contextbill": "dist/cli.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "prices.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MohammedAlkindi/contextbill.git"
  },
  "homepage": "https://github.com/MohammedAlkindi/contextbill#readme",
  "bugs": {
    "url": "https://github.com/MohammedAlkindi/contextbill/issues"
  },
  "workspaces": [
    "web"
  ]
}
