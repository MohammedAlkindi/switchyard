# Copy this file to .env and fill in your values.
# Never commit .env to version control.
#
# Security: API keys set here are loaded at startup and never written to disk by the app.
# Keys entered in Settings → API Keys are stored in configs/user_settings.json (gitignored).
# Prefer .env for production deployments — it is more portable and avoids disk writes.

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...

# --- OpenAI (optional, for future openai_client.py) ---
OPENAI_API_KEY=sk-...

# --- App settings (optional) ---
CORTEXAI_LOG_LEVEL=INFO        # DEBUG | INFO | WARNING | ERROR
CORTEXAI_MAX_TOKENS=2048
CORTEXAI_API_PORT=8000         # port for the FastAPI server
